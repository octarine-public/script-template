{
	"name": "@@packageName@@",
	"version": "1.0.0",
	"description": "@@description@@",
	"author": "@@author@@",
	"license": "@@license@@",
	"private": true,
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"check": "npm run check-types && npm run lint:check && npm run check-circular && npm run check-bundle",
		"check-types": "tsc",
		"check-types-watch": "tsc --watch",
		"lint": "eslint . --fix",
		"lint:check": "eslint .",
		"check-circular": "madge --circular --extensions ts,tsx src/index.ts",
		"check-bundle": "node tools/check-bundle.cjs",
		"update-sdk": "git -C @@sdkDir@@ pull --ff-only"
	},
	"devDependencies": {
		"@typescript-eslint/eslint-plugin": "^8.67.0",
		"@typescript-eslint/parser": "^8.67.0",
		"eslint": "^10.8.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-import-x": "^4.17.1",
		"eslint-plugin-prettier": "^5.5.6",
		"eslint-plugin-simple-import-sort": "^14.0.0",
		"eslint-plugin-unicorn": "^73.0.0",
		"eslint-plugin-unused-imports": "^4.4.1",
		"madge": "^8.0.0",
		"prettier": "^3.9.6",
		"typescript": "^6.0.3"
	},
	"overrides": {
		"madge": {
			"typescript": "$typescript"
		}
	},
	"engines": {
		"node": ">=20.19"
	},
	"octarineBundle": true,
	"octarineMinimize": false,
	"octarineObfuscate": false,
	"octarineTreeShaking": true
}
